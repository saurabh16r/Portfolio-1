# ==================================================
# SERVER ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the values.
# ==================================================

# Server execution port
PORT=5000

# Client React Application address
CLIENT_URL=http://localhost:3000

# JWT Auth encryption key
JWT_SECRET=your_jwt_encryption_secret_key_12345

# MongoDB connection string
# Can define MONGODB_URI or MONGO_URI
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio-studio
MONGO_URI=mongodb://127.0.0.1:27017/portfolio-studio

# Cloudinary credentials (server-side only, do not expose to client)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Default Administrator login credentials (for initial database seeding)
INITIAL_ADMIN_EMAIL=admin@portfolio.studio
INITIAL_ADMIN_PASSWORD=adminpassword123
