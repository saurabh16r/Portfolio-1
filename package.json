{
  "name": "portfolio-studio-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:freelance": "pnpm --filter frontend-freelance dev",
    "dev:job": "pnpm --filter frontend-job dev",
    "dev:server": "pnpm --filter server dev",
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:freelance\" \"pnpm dev:job\"",
    "build:freelance": "pnpm --filter frontend-freelance build",
    "build:job": "pnpm --filter frontend-job build",
    "build:server": "pnpm --filter server build",
    "seed": "pnpm --filter server seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
